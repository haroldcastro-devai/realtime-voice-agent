# Copy to .env. No production tenant values belong here.

LOG_LEVEL=INFO
LISTEN_HOST=0.0.0.0
DASHBOARD_PORT=8080
AUDIOSOCKET_PORT=9092

# mock | openai_compat | remote
# remote = NeMo on Google Colab (GPU). LLM stays on the PC.
STT_BACKEND=mock
LLM_BACKEND=mock
TTS_BACKEND=mock

REMOTE_INFERENCE_URL=
REMOTE_INFERENCE_TOKEN=

# Optional OpenAI-compatible endpoints (OpenAI, vLLM, local servers).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

AGENT_NAME=Ava
AGENT_SYSTEM_PROMPT=You are Ava, a concise phone assistant. Keep answers under two sentences. Speak naturally in the caller's language.

SAMPLE_RATE=8000
FRAME_MS=20
